{
  "name": "nova",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @nova/client dev",
    "dev:server": "pnpm --filter @nova/server dev",
    "build": "pnpm --filter @nova/client build",
    "test": "pnpm --filter @nova/core test",
    "typecheck": "pnpm -r typecheck",
    "shots": "node tools/shots/shots.mjs",
    "balance": "pnpm --filter @nova/core balance",
    "mobile:assets": "node tools/mobile/assets.mjs",
    "mobile:sync": "pnpm --filter @nova/client build && pnpm --filter @nova/client exec cap sync",
    "android:apk": "pnpm mobile:sync && cd packages/client/android && ./gradlew assembleDebug"
  }
}
